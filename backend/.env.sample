# listmonk Python FastAPI backend — environment variables
# Copy to .env and fill in your values.

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=listmonk
DB_PASSWORD=listmonk
DB_NAME=listmonk
DB_SSL_MODE=disable

# App
APP_ROOT_URL=http://localhost:9000
APP_SITE_NAME=listmonk
APP_FROM_EMAIL=noreply@example.com
APP_LANG=en

# Security — CHANGE THIS IN PRODUCTION
SECRET_KEY=changeme_use_a_long_random_value_in_production

# Upload (filesystem provider)
UPLOAD_PROVIDER=filesystem
UPLOAD_FILESYSTEM_UPLOAD_PATH=./uploads
UPLOAD_FILESYSTEM_UPLOAD_URI=/uploads

# Feature flags
ENABLE_PUBLIC_SUBSCRIPTION_PAGE=true
ENABLE_PUBLIC_ARCHIVE=true
BOUNCE_WEBHOOKS_ENABLED=false
CHECK_UPDATES=true

# Firestore (migration target — path to the service account key, gitignored,
# never commit the actual file)
FIREBASE_CREDENTIALS_PATH=firebase-credentials.json

# Per-domain repo backend: "postgres" (default) or "firestore". Flip one
# domain at a time as its migration phase lands — see the migration plan.
REPO_BACKEND_MEDIA=postgres
REPO_BACKEND_SETTINGS=postgres
REPO_BACKEND_SESSIONS=postgres
REPO_BACKEND_ROLES=postgres
REPO_BACKEND_USERS=postgres
# Do not flip this to firestore until Phase 4b (Subscribers) lands -
# Subscribers/Campaigns still directly JOIN Postgres's `lists` table.
REPO_BACKEND_LISTS=postgres
# Safe to flip: routers are wired up and verified end-to-end (signup,
# opt-in confirmation, admin CRUD, browse/search). The one gap is the
# arbitrary-SQL segmentation feature (?query=), which only ever runs
# against Postgres and is rejected with a clear error if subscribers are
# Firestore-backed - it's blocked on a product decision, see the migration
# plan, Phase 7.
REPO_BACKEND_SUBSCRIBERS=postgres
